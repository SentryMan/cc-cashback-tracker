<div class="card-item bg-white rounded-2xl shadow-sm p-5 border border-slate-100/50"
     data-card-id="{{id}}">
  <div class="flex justify-between items-start mb-3">
    <div>
      <h3 class="font-bold text-slate-800 text-base leading-tight">{{name}}</h3>
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">{{network}}</span>
    </div>
    <div class="text-right">
      <span class="text-xs text-slate-400">Annual Fee</span>
      <p class="font-bold text-slate-700 text-sm">{{annualFee}}</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-1.5 mb-2">
    {{#rates}}
    <span class="text-xs font-bold px-2 py-1 rounded-full {{cssClass}} inline-flex items-center gap-1">{{category}} {{rate}}<button
        hx-delete="/cards/{{cardId}}/rates/{{encodedCategory}}"
        hx-target="closest .card-item"
        hx-swap="outerHTML"
        class="opacity-50 hover:opacity-100 font-bold leading-none">×</button></span>
    {{/rates}}
  </div>
  <form hx-post="/cards/{{id}}/rates" hx-target="closest .card-item" hx-swap="outerHTML"
        class="flex gap-1.5 items-center mb-3">
    <select name="category" class="flex-1 border border-slate-200 rounded-lg px-2 py-1 text-xs text-slate-600 outline-none focus:ring-1 focus:ring-indigo-400">
      {{#categories}}<option>{{.}}</option>{{/categories}}
    </select>
    <input name="rate" type="number" min="0" max="100" step="0.5" placeholder="%"
           class="w-16 border border-slate-200 rounded-lg px-2 py-1 text-xs outline-none focus:ring-1 focus:ring-indigo-400">
    <button type="submit" class="text-xs bg-indigo-500 hover:bg-indigo-600 text-white px-2.5 py-1 rounded-lg font-semibold transition-colors">Add</button>
  </form>
  {{#hasLimit}}
  <div class="mb-3 bg-slate-50 rounded-xl p-3">
    <div class="flex justify-between items-center mb-2">
      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Spend Progress</span>
      {{#limitReached}}<span class="text-xs font-bold text-red-500 bg-red-50 px-2 py-0.5 rounded-full">Limit reached</span>{{/limitReached}}
      {{^limitReached}}<span class="text-xs text-slate-500">{{spentFormatted}} / {{rewardLimitFormatted}}</span>{{/limitReached}}
    </div>
    <div class="w-full bg-slate-200 rounded-full h-1.5">
      <div class="{{barColor}} h-1.5 rounded-full transition-all" style="width:{{pct}}%"></div>
    </div>
  </div>
  <div class="mb-3 pt-1">
    <button hx-delete="/cards/{{id}}/earnings"
            hx-target="closest .card-item"
            hx-swap="outerHTML"
            hx-confirm="Reset all spend for {{name}}?"
            class="text-xs text-amber-500 hover:text-amber-700 font-semibold transition-colors">
      Reset spend
    </button>
  </div>
  {{/hasLimit}}
  {{^hasLimit}}{{#hasAnnualFee}}
  <div class="mb-3">
    <span class="text-xs text-slate-500">Spent: <strong class="text-slate-700">{{spentFormatted}}</strong></span>
  </div>
  <div class="mb-3 pt-1">
    <button hx-delete="/cards/{{id}}/earnings"
            hx-target="closest .card-item"
            hx-swap="outerHTML"
            hx-confirm="Reset all spend for {{name}}?"
            class="text-xs text-amber-500 hover:text-amber-700 font-semibold transition-colors">
      Reset spend
    </button>
  </div>
  {{/hasAnnualFee}}{{/hasLimit}}
  <div class="flex gap-4 pt-1 border-t border-slate-50">
    <button hx-delete="/cards/{{id}}"
            hx-confirm="Remove {{name}}?"
            hx-on::after-request="if(event.detail.successful){var c=this.closest('.card-item');if(c)c.remove()}"
            class="text-xs text-red-400 hover:text-red-600 font-semibold transition-colors">
      Remove card
    </button>
  </div>
</div>

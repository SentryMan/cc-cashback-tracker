<div class="grid grid-cols-3 gap-3">
  <div class="bg-white rounded-2xl p-4 text-center shadow-sm">
    <p class="text-xs text-indigo-400 font-semibold uppercase tracking-wide mb-1">Spent</p>
    <p class="text-lg font-black text-indigo-700">{{totalSpend}}</p>
  </div>
  <div class="bg-white rounded-2xl p-4 text-center shadow-sm">
    <p class="text-xs text-green-400 font-semibold uppercase tracking-wide mb-1">Earned</p>
    <p class="text-lg font-black text-green-600">{{totalCashback}}</p>
  </div>
  <div class="bg-white rounded-2xl p-4 text-center shadow-sm">
    <p class="text-xs text-amber-400 font-semibold uppercase tracking-wide mb-1">Transactions</p>
    <p class="text-lg font-black text-amber-600">{{txCount}}</p>
  </div>
</div>

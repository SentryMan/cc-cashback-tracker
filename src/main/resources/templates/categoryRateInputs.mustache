{{#inputs}}<div class="space-y-1">
  <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide">{{label}}</label>
  <div class="relative">
    <input name="{{paramName}}" type="number" min="0" max="20" step="0.5" placeholder="0"
           class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-400 outline-none pr-7">
    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-medium pointer-events-none">%</span>
  </div>
</div>
{{/inputs}}{{^inputs}}<p class="col-span-2 text-sm text-slate-400 text-center py-3 bg-slate-50 rounded-xl">Add categories first in "Manage Categories".</p>
{{/inputs}}